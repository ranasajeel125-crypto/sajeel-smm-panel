# Copy to .env (local dev) or set these in the Render dashboard (production).
# Never commit real values.

# Turso (libsql) database. Local dev: file:./data/local.db
TURSO_DATABASE_URL=
# Turso auth token (only needed for remote libsql:// URLs)
TURSO_AUTH_TOKEN=

# Secret required by the "Forgot password?" owner-recovery endpoint.
# Pick a long random string, e.g. output of: openssl rand -hex 32
RECOVERY_SECRET=

# Port the server listens on (Render sets PORT automatically)
PORT=3000
